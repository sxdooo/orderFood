# App
APP_ENV=development
HTTP_PORT=8080
TZ=Asia/Shanghai

# MySQL
# Local: localhost | Docker Compose api service: mysql (see deploy/docker-compose.yml)
MYSQL_DSN=root:orderfood@tcp(localhost:3306)/orderfood?charset=utf8mb4&parseTime=True&loc=Asia%2FShanghai

# Redis
# Local: localhost | Docker Compose api service: redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRATION_HOURS=168

# WeChat Mini Program
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# WeChat Pay (API v3)
WECHAT_MCH_ID=
WECHAT_MCH_SERIAL=
WECHAT_API_V3_KEY=
WECHAT_PRIVATE_KEY_PATH=/secrets/apiclient_key.pem
WECHAT_NOTIFY_URL=https://your-domain.com/api/v1/pay/notify

# Amap (Gaode)
AMAP_API_KEY=

# Aliyun OSS
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=orderfood-images
