# =============================================================================
# server/.env  —— copy this file to server/.env on the deploy host and fill in
# the real secrets below (WeChat / Amap / JWT / OSS).
#
# NOTE: When running via deploy/docker-compose.yml, the following keys are
# OVERRIDDEN by the compose `environment:` block and you do NOT need to set them
# here: APP_ENV, HTTP_PORT, MYSQL_DSN, REDIS_ADDR, REDIS_PASSWORD, REDIS_DB.
# They are kept below only as documentation / for local `go run`.
# =============================================================================

# App
APP_ENV=production
HTTP_PORT=4000
TZ=Asia/Shanghai

# MySQL
# Docker Compose (api service): host = mysql, db = orderfood. Overridden by compose.
# Local `go run`: replace `mysql` with `localhost` and use your local password.
MYSQL_DSN=root:orderfood@tcp(mysql:3306)/orderfood?charset=utf8mb4&parseTime=True&loc=Asia%2FShanghai

# Redis
# Docker Compose (api service): host = redis, password enabled. Overridden by compose.
# Local `go run`: replace `redis` with `localhost`.
REDIS_ADDR=redis:6379
REDIS_PASSWORD=orderfood
REDIS_DB=0

# JWT  (REQUIRED: set a long random string in production)
JWT_SECRET=change-me-in-production
JWT_EXPIRATION_HOURS=168

# WeChat Mini Program  (REQUIRED)
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# WeChat Pay (API v3)
WECHAT_MCH_ID=
WECHAT_MCH_SERIAL=
WECHAT_API_V3_KEY=
WECHAT_PRIVATE_KEY_PATH=/secrets/apiclient_key.pem
WECHAT_NOTIFY_URL=https://your-domain.com/api/v1/pay/notify

# Amap (Gaode)  (REQUIRED for route/geocode features)
AMAP_API_KEY=

# Aliyun OSS  (REQUIRED for image upload)
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=orderfood-images
