# =============================================================================
# deploy/.env  —— compose-level variables for docker-compose.yml substitution.
# Copy to deploy/.env on the host. These set the MySQL root password and the
# Redis password used by BOTH the mysql/redis containers and the api service,
# so they always stay in sync.
# =============================================================================

# Database root password (used by mysql container + injected into api MYSQL_DSN)
MYSQL_ROOT_PASSWORD=change-me-strong-password

# Redis password (used by `redis-server --requirepass` + api REDIS_PASSWORD)
REDIS_PASSWORD=change-me-strong-password

# Optional image overrides
# MYSQL_IMAGE=mysql:8.0
# REDIS_IMAGE=redis:7-alpine
